{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "team-lead",
  "instructions": ["AGENTS.md"],

  "agent": {
    "build": {
      "description": "Agent build — phát triển script/query/skill/agent mới, điều chỉnh chính sách chung",
      "mode": "primary",
      "prompt": "{file:AGENT_INSTRUCTION.md}",
      "color": "#4B4646",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "skill": "allow"
      }
    },

    "plan": {
      "description": "Phân tích và lập kế hoạch — read-only, không sửa code",
      "mode": "primary",
      "temperature": 0.1,
      "color": "#656363",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "skill": "allow"
      }
    },

    "team-lead": {
      "description": "Điều phối Data Team — giao task, theo dõi, tổng hợp kết quả. READ-ONLY: không edit/exec ngoài docs/",
      "mode": "primary",
      "prompt": "{file:.opencode/agents/team-lead.md}",
      "model": "opencode/big-pickle",
      "color": "#E74C3C",
      "temperature": 0.3,
      "permission": {
        "task": { "*": "allow" },
        "edit": {
          "*": "deny",
          "docs/**": "allow"
        },
        "bash": {
          "*": "deny",
          "mkdir docs/*": "allow",
          "mkdir -p docs/*": "allow",
          "mkdir -p docs/*/*": "allow"
        },
        "read": {
          "*": "deny",
          "docs/**": "allow",
          ".opencode/agents/*.md": "allow",
          ".opencode/skills/*/SKILL.md": "allow",
          "catalog/**": "allow",
          "query/README.md": "allow",
          "script/index.md": "allow",
          "README.md": "allow",
          "AGENTS.md": "allow",
          "AGENT_INSTRUCTION.md": "allow",
          "guide_book.md": "allow",
          "CODING_CONVENTIONS.md": "allow",
          "opencode.json": "allow"
        },
        "glob": {
          "*": "deny",
          "docs/**": "allow",
          ".opencode/agents/*.md": "allow",
          ".opencode/skills/*/SKILL.md": "allow",
          "catalog/**": "allow"
        },
        "grep": {
          "*": "deny",
          "docs/**": "allow",
          ".opencode/agents/*.md": "allow",
          ".opencode/skills/*/SKILL.md": "allow",
          "catalog/**": "allow"
        }
      }
    },

    "ba": {
      "description": "Business Analyst — giao tiếp User, viết Data_Requirement.md",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/ba.md}",
      "model": "opencode/big-pickle",
      "color": "#3498DB",
      "temperature": 0.4,
      "permission": {
        "read": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow"
        },
        "glob": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow"
        },
        "grep": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow"
        },
        "list": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/**": "allow"
        },
        "bash": {
          "*": "deny"
        },
        "websearch": "allow",
        "webfetch": "allow"
      }
    },

    "data-architect": {
      "description": "Data Architect — thiết kế schema, viết design doc theo format catalog",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/data-architect.md}",
      "model": "opencode/big-pickle",
      "color": "#9B59B6",
      "temperature": 0.2,
      "permission": {
        "read": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow"
        },
        "glob": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow"
        },
        "grep": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow"
        },
        "list": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/*/design/*": "allow"
        },
        "bash": {
          "*": "deny",
          "python script/build_catalog.py": "allow",
          "python script/build_lineage_from_design.py": "allow"
        }
      }
    },

    "developer": {
      "description": "Developer — viết .sh/.sql/ABI, chạy test qua Docker, _dev suffix",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/developer.md}",
      "model": "opencode/big-pickle",
      "color": "#2ECC71",
      "temperature": 0.2,
      "permission": {
        "read": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "guide_book.md": "allow",
          "CODING_CONVENTIONS.md": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "glob": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "grep": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "list": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "edit": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/*/design/*": "allow",
          "docs/*/development.md": "allow"
        },
        "bash": {
          "*": "deny",
          "python query/*": "allow",
          "python script/*": "allow",
          "* > script/*": "deny",
          "* >> script/*": "deny",
          "* > query/*": "deny",
          "* >> query/*": "deny",
          "touch script/*": "deny",
          "touch query/*": "deny",
          "touch .opencode/skills/*": "deny",
          "mkdir script/*": "deny",
          "mkdir query/*": "deny",
          "cp * script/*": "deny",
          "cp * query/*": "deny",
          "mv * script/*": "deny",
          "mv * query/*": "deny"
        },
        "skill": "allow"
      }
    },

    "tester": {
      "description": "Tester — kiểm thử job, viết test case, chạy test trên _dev tables",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/tester.md}",
      "model": "opencode/big-pickle",
      "color": "#F39C12",
      "temperature": 0.1,
      "permission": {
        "read": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "guide_book.md": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "glob": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "grep": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "list": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/*/test/*": "allow"
        },
        "bash": {
          "*": "deny",
          "python query/*": "allow",
          "python script/*": "allow"
        }
      }
    },

    "dataops": {
      "description": "DataOps — cấu hình job, triển khai bảng mới, chạy UAT, monitor, quản lý DAG",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/dataops.md}",
      "model": "opencode/big-pickle",
      "color": "#1ABC9C",
      "temperature": 0.2,
      "permission": {
        "read": {
          "*": "deny",
          "chainslake/**": "allow",
          "docker/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "guide_book.md": "allow",
          "CODING_CONVENTIONS.md": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "glob": {
          "*": "deny",
          "chainslake/**": "allow",
          "docker/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "grep": {
          "*": "deny",
          "chainslake/**": "allow",
          "docker/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "list": {
          "*": "deny",
          "chainslake/**": "allow",
          "docker/**": "allow",
          "docs/**": "allow",
          "template/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "edit": {
          "*": "deny",
          "chainslake/**": "allow",
          "docs/*/UAT.md": "allow"
        },
        "bash": {
          "*": "deny",
          "python query/*": "allow",
          "python script/*": "allow",
          "docker *": "allow",
          "* > script/*": "deny",
          "* >> script/*": "deny",
          "* > query/*": "deny",
          "* >> query/*": "deny",
          "* > .opencode/skills/*": "deny",
          "* >> .opencode/skills/*": "deny",
          "* > opencode.json*": "deny",
          "* >> opencode.json*": "deny",
          "touch script/*": "deny",
          "touch query/*": "deny",
          "touch .opencode/skills/*": "deny",
          "mkdir script/*": "deny",
          "mkdir query/*": "deny",
          "mkdir .opencode/skills/*": "deny",
          "cp * script/*": "deny",
          "cp * query/*": "deny",
          "cp * .opencode/skills/*": "deny",
          "mv * script/*": "deny",
          "mv * query/*": "deny",
          "mv * .opencode/skills/*": "deny"
        },
        "skill": "allow"
      }
    },

    "data-analyst": {
      "description": "Data Analyst — xây dựng Metabase, viết truy vấn tối ưu, cập nhật kết quả",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/data-analyst.md}",
      "model": "opencode/big-pickle",
      "color": "#E67E22",
      "temperature": 0.5,
      "permission": {
        "read": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "glob": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "grep": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "list": {
          "*": "deny",
          "docs/**": "allow",
          "template/**": "allow",
          "catalog/**": "allow",
          "script/**": "allow",
          "query/**": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/*/Data_Requirement.md": "allow"
        },
        "bash": {
          "*": "deny",
          "python query/*": "allow",
          "python script/*": "allow",
          "mb *": "allow"
        },
        "skill": "allow"
      }
    }
  }
}
